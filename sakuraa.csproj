<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SakuraaCastingMod</AssemblyName>
    <RootNamespace>SakuraaCastingMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Paths into the local Gorilla Tag install used to resolve game/BepInEx references.
       Override these (e.g. via -p:GameDir=... or a Directory.Build.props) on another machine. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <GTManaged>$(GameDir)\Gorilla Tag_Data\Managed</GTManaged>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Overrides the net472 targeting pack's netstandard 2.0 facade: several Gorilla Tag
         Managed assemblies (e.g. UnityEngine.AudioModule) were built against netstandard 2.1. -->
    <Reference Include="netstandard"><HintPath>$(GTManaged)\netstandard.dll</HintPath><Private>false</Private></Reference>

    <!-- Gorilla Tag ships its own patched mscorlib with Span<T>/ReadOnlySpan<T> built in;
         the vanilla net472 targeting pack's mscorlib doesn't have them, which several
         UnityEngine.AudioModule APIs (e.g. AudioClip.GetData/SetData) require. -->
    <Reference Include="mscorlib"><HintPath>$(GTManaged)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(GTManaged)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(GTManaged)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml"><HintPath>$(GTManaged)\System.Xml.dll</HintPath><Private>false</Private></Reference>

